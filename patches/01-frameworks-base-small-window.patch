+        animator.addListener(new AnimatorListenerAdapter() {
+            private boolean mFinished;
+
+            @Override
+            public void onAnimationEnd(Animator animation) {
+                if (mFinished) return;
+                mFinished = true;
+                transaction.close();
+                onEnd.accept(animation);
+            }
+        });
+        return animator;
+    }
