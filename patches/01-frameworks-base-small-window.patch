diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/AuraSmallWindowGestureSession.java b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/AuraSmallWindowGestureSession.java
new file mode 100644
--- /dev/null
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/AuraSmallWindowGestureSession.java
@@ -0,0 +1,215 @@
+/* Copyright 2026 The Android Open Source Project
