<?xml version="1.0" encoding="utf-8"?>
<!-- Icon tint for Aura small-window caption buttons on dark backgrounds. Dim on press;
     constant across focus states (readability must not depend on task focus). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="#99FFFFFF"/>
    <item android:color="#F2FFFFFF"/>
</selector>
