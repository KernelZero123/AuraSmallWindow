<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Aura small-window "more" menu. Sizes are layout-preview defaults;
     CaptionWindowDecoration applies 1/scale-compensated physical sizes at runtime. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
        android:id="@+id/aura_menu_item_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"/>
    <TextView
        android:id="@+id/aura_menu_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="14sp"/>
</LinearLayout>
